# App Configuration
NODE_ENV=development
PORT=5000
APP_NAME=College ERP
APP_URL=http://localhost:5000

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eiilm_college
DB_USER=root
DB_PASSWORD=root

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Cloudinary CDN Configuration (Optional - falls back to local disk storage if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eiilm.edu

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000

# OpenAI Chatbot Configuration (Optional - uses rule-based knowledge fallback if unset)
OPENAI_API_KEY=
AI_MODEL=gpt-3.5-turbo

# Seed Credentials
SEED_SUPERADMIN_EMAIL=superadmin@eiilm.edu
SEED_SUPERADMIN_PASSWORD=SuperAdmin@123
SEED_ADMIN_EMAIL=admin@eiilm.edu
SEED_ADMIN_PASSWORD=Admin@123
SEED_FACULTY_EMAIL=faculty@eiilm.edu
SEED_FACULTY_PASSWORD=Faculty@123
SEED_STUDENT_EMAIL=student@eiilm.edu
SEED_STUDENT_PASSWORD=Student@123
